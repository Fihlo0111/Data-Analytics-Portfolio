
CREATE TABLE Employees
(
    EmployeeID INT IDENTITY(1,1) PRIMARY KEY,

    FirstName VARCHAR(50),

    LastName VARCHAR(50),

    Position VARCHAR(50),

    HireDate DATE,

    StoreID INT,

    CONSTRAINT FK_Employee_Store
        FOREIGN KEY(StoreID)
        REFERENCES Stores(StoreID)
);

